pragma solidity ^0.8.24;

import {Test, console2} from "forge-std/Test.sol";
import {Vm} from "forge-std/Vm.sol";
import {Engine} from "../src/Engine.sol";
import {BoutCodec} from "../src/BoutCodec.sol";

/// @dev Verifies ONE vector per external call (so each gets a fresh memory frame — Solidity never frees memory within a call).
contract VectorChecker {
    Vm private constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));

    function _legalPacked(uint8[] memory l) internal pure returns (bytes memory d) {
        d = new bytes(l.length * 2);
        for (uint256 i = 0; i < l.length; i++) {
            d[i * 2] = 0x00;
            d[i * 2 + 1] = bytes1(l[i]);
        }
    }

    /// @return isTurn true for a turn vector, false for a replacement vector
    function check(string memory line) external view returns (bool isTurn) {
        string[] memory f = vm.split(line, " ");
        bytes memory state = vm.parseBytes(f[4]);
        Engine.Bout memory b = BoutCodec.unpack(state);
        require(keccak256(BoutCodec.pack(b)) == keccak256(state), "codec round-trip");

        if (keccak256(bytes(f[0])) == keccak256("T")) {
            uint8 a = uint8(vm.parseUint(f[2]));
            uint8 c = uint8(vm.parseUint(f[3]));
            require(keccak256(_legalPacked(Engine.legalActions(b, 0))) == keccak256(vm.parseBytes(f[7])), "legal actions A");
            require(keccak256(_legalPacked(Engine.legalActions(b, 1))) == keccak256(vm.parseBytes(f[8])), "legal actions B");
            Engine.Ev[] memory ev = Engine.resolveTurn(b, a, c);
            require(keccak256(BoutCodec.pack(b)) == keccak256(vm.parseBytes(f[5])), "next state differs from TS");
            require(keccak256(BoutCodec.packEvents(ev)) == keccak256(vm.parseBytes(f[6])), "events differ from TS");
            return true;
        }
        Engine.Ev[] memory ev2 = Engine.applyReplacements(b, uint8(vm.parseUint(f[2])), uint8(vm.parseUint(f[3])));
        require(keccak256(BoutCodec.pack(b)) == keccak256(vm.parseBytes(f[5])), "replacement state differs from TS");
        require(keccak256(BoutCodec.packEvents(ev2)) == keccak256(vm.parseBytes(f[6])), "replacement events differ from TS");
        return false;
    }
}

/// @notice The Solidity engine must reproduce the TypeScript engine EXACTLY: next state, event list and legal-action lists
///         for every vector in packages/engine/vectors/engine-vectors.txt (generated by the engine package `vectors` script).
contract EngineVectorsTest is Test {
    string constant PATH = "../packages/engine/vectors/engine-vectors.txt";

    function test_all_vectors() public {
        VectorChecker checker = new VectorChecker();
        uint256 turns;
        uint256 repl;
        uint256 lineNo;
        while (true) {
            string memory line = vm.readLine(PATH);
            if (bytes(line).length == 0) break;
            lineNo++;
            if (bytes(line)[0] == "#") continue;
            try checker.check(line) returns (bool isTurn) {
                if (isTurn) turns++;
                else repl++;
            } catch Error(string memory why) {
                emit log_named_uint("FAILED at vector line", lineNo);
                emit log_named_string("reason", why);
                fail();
                break;
            }
        }
        vm.closeFile(PATH);
        console2.log("turn vectors:", turns);
        console2.log("replacement vectors:", repl);
        assertGt(turns, 500, "too few vectors");
    }
}
