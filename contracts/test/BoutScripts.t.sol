pragma solidity ^0.8.24;

import {console2} from "forge-std/Test.sol";
import {Cards} from "../src/Cards.sol";
import {Armory} from "../src/Armory.sol";
import {Arena} from "../src/Arena.sol";
import {Harness} from "./Harness.sol";

/// @notice END-TO-END PARITY: whole bouts generated by the TypeScript engine are replayed through the real contracts —
///         mint cards → register pools → challenge/accept → commit/reveal every move (Full: blinded hands, openings on switch /
///         trick / replacement, OpenCards pauses) — and the final packed state stored by the Arena must equal the TypeScript
///         engine's, byte for byte. (packages/engine/vectors/bout-scripts.txt)
///
///         Full scripts bring a RANDOM 3-of-N fighters + 2-of-M tricks in a random slot order out of an 8-card pool, so a pass proves
///         the contracts honour the player's secret selection (not "the first cards of the pool").
///         For Full the final state is compared after both sides publish the rest of their hand (`openAfter`), which is the only
///         difference between the hidden-information state and the engine's full-information state.
contract BoutScriptsTest is Harness {
    string constant PATH = "../packages/engine/vectors/bout-scripts.txt";
    uint256 fullBouts;
    uint256 decisionPauses; // OpenCards pause -> the bout ended by a turn-cap decision
    uint256 suddenPauses; // OpenCards pause -> sudden-death re-entry happened

    /// @dev one script per external call → a fresh memory frame each time
    function runScript(string memory line) external {
        string[] memory f = vm.split(line, " ");
        uint8 format = uint8(vm.parseUint(f[1]));
        bool full = format == 1;
        _deploy(true);
        uint256 id = _setup(f, format);
        _leads(id, f, full);

        string[] memory steps = vm.split(f[6], ";");
        for (uint256 i = 0; i < steps.length; i++) {
            _step(id, steps[i], full);
            if (_phase(id) == Arena.Phase.OpenCards) _pauseAndClassify(id);
        }
        require(_phase(id) == Arena.Phase.Over, "bout did not finish");
        if (full) {
            _openRest(id);
            fullBouts++;
        }
        require(keccak256(arena.getState(id)) == keccak256(vm.parseBytes(f[7])), "final state differs from TS engine");
    }

    /// @dev play the pause and record WHICH rule needed it: sudden-death re-entry leaves the sudden flag set (packed int16 #3);
    ///      a decision pause ends the bout with reason DECISION (packed int16 #5)
    function _pauseAndClassify(uint256 id) private {
        _doOpenPhase(id);
        bytes memory st = arena.getState(id);
        if (uint8(st[7]) == 1) suddenPauses++;
        else if (_phase(id) == Arena.Phase.Over && uint8(st[11]) == 1) decisionPauses++;
    }

    function _setup(string[] memory f, uint8 format) private returns (uint256 id) {
        (uint256 poolA, uint256[] memory idsA) = _mintPool(ALICE, f[4], format);
        (uint256 poolB, uint256[] memory idsB) = _mintPool(BOB, f[5], format);
        vm.prank(ALICE);
        id = arena.createChallenge(format, poolA);
        vm.prank(BOB);
        arena.acceptChallenge(id, poolB);
        if (format == 1) {
            _setHand(id, 0, idsA, _parseSel(f[8]));
            _setHand(id, 1, idsB, _parseSel(f[9]));
        }
    }

    function _leads(uint256 id, string[] memory f, bool full) private {
        uint8 leadA = uint8(vm.parseUint(f[2]));
        uint8 leadB = uint8(vm.parseUint(f[3]));
        if (full) {
            _commitLeadFull(id, 0, leadA);
            _commitLeadFull(id, 1, leadB);
            _revealLeadFull(id, 0, leadA);
            _revealLeadFull(id, 1, leadB);
        } else {
            _commitStd(id, 0, TAG_LEAD, 0, leadA);
            _commitStd(id, 1, TAG_LEAD, 0, leadB);
            _revealStd(id, 0, TAG_LEAD, 0, leadA);
            _revealStd(id, 1, TAG_LEAD, 0, leadB);
        }
    }

    /// @dev one script step: T:a:b (turn) or R:c0:c1 (replacement)
    function _step(uint256 id, string memory step, bool full) private {
        string[] memory p = vm.split(step, ":");
        uint8 x = uint8(vm.parseUint(p[1]));
        uint8 y = uint8(vm.parseUint(p[2]));
        uint8 turn = _turnNow(id);
        bool isTurn = keccak256(bytes(p[0])) == keccak256("T");
        uint8 tag = isTurn ? TAG_ACTION : TAG_REPLACE;
        bool[2] memory acts = isTurn ? [true, true] : _needsReal(id);
        if (acts[0]) _commitStd(id, 0, tag, turn, x);
        if (acts[1]) _commitStd(id, 1, tag, turn, y);
        if (acts[0]) _revealAuto(id, 0, tag, turn, x, full);
        if (acts[1]) _revealAuto(id, 1, tag, turn, y, full);
    }

    function _needsReal(uint256 id) private view returns (bool[2] memory needs) {
        (,,,,,,, needs,,) = arena.getBout(id);
    }

    function test_ts_bouts_replayed_through_contracts() public {
        uint256 n;
        while (true) {
            string memory line = vm.readLine(PATH);
            if (bytes(line).length == 0) break;
            try this.runScript(line) {
                n++;
            } catch Error(string memory why) {
                emit log_named_uint("FAILED script #", n);
                emit log_named_string("reason", why);
                fail();
                break;
            }
        }
        vm.closeFile(PATH);
        console2.log("bouts replayed through the contracts:", n);
        console2.log("  of which Full (hidden hands):", fullBouts);
        console2.log("  OpenCards pauses played through:", opensSeen);
        console2.log("    turn-cap decision pauses:", decisionPauses);
        console2.log("    sudden-death re-entry pauses:", suddenPauses);
        assertGt(n, 50);
        assertGt(fullBouts, 30);
        assertGt(decisionPauses, 2, "no script exercised the turn-cap decision pause");
        assertGt(suddenPauses, 2, "no script exercised the sudden-death re-entry pause");
    }
}
